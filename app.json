{
  "expo": {
    "name": "Gabiflix",
    "slug": "gabiflix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-gabiflix.png",
    "scheme": "gabiflix",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E91E63",
        "foregroundImage": "./assets/images/icon-gabiflix.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gabiflix.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-gabiflix.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-gabiflix.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#E91E63",
          "dark": {
            "image": "./assets/images/splash-gabiflix.png",
            "backgroundColor": "#E91E63"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a6c1abf-477e-4186-b0d2-f50b70331c97"
      }
    }
  }
}
